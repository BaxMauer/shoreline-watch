{
  "name": "shoreline-watch",
  "version": "1.26.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "audit:production": "node scripts/audit-dependencies.mjs --production",
    "audit:all": "node scripts/audit-dependencies.mjs --all",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "version:check": "node scripts/check-release-version.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "displayName": "Shoreline Watch"
}
